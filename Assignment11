package edu.ccis;

public class Employee {
	// fields
	private String name;
	private double hoursWorked;
	private double hourlyPay;
	private static double overtime;
	private static int numberOfEmployees;
	
	// accessors
	public String getName() {
		return name;
	}
	public double getHoursWorked() {
		return hoursWorked;
	}
	public double getHourlyPay() {
		return hourlyPay;
	}
	public double getOvertime() {
		return overtime;
	}
	public int getNumberOfEmployees() {
		return numberOfEmployees;
	}
	
	// mutators
	public void setName(String name) {
		this.name = name;
	}
	public void setHoursWorked(double hoursWorked) {
		this.hoursWorked = hoursWorked;
	}
	public void setHourlyPay(double hourlyPay) {
		this.hourlyPay = hourlyPay;
	}
	public void setOvertime(double overtime) {
		Employee.overtime = overtime;
	}
	
	// constructor
	public Employee(String name, double hoursWorked, double hourlyPay) {
		this.name = name;
		this.hoursWorked = hoursWorked;
		this.hourlyPay = hourlyPay;
		numberOfEmployees++;
	}
	
	// method
	public double calculatePay() {
		if (hoursWorked > 40) {
			double regularPay = 40 * hourlyPay;
			double overtimeHours = hoursWorked - 40;
			double overtimePay = overtimeHours * hourlyPay * overtime;
			return regularPay + overtimePay;
		} 
		else {
			return hoursWorked * hourlyPay;
		}
	}
	
	// toString
	@Override
	public String toString() {
		String str;
		str = String.format("Name: %s%nHours Worked: %.2f%nHourly Rate: %.2f%n"
							+ "Weekly Pay: %.2f%nTotal Employees: %d%n",
							getName(), getHoursWorked(), getHourlyPay(), calculatePay(),
							getNumberOfEmployees());
		return str;
	}

}



package edu.ccis;
import java.util.Scanner;

public class EmployeeTest {

	public static void main(String[] args) {
		Scanner input = new Scanner(System.in);
		// variables
		int numberOfEmployees = 0;
		String name;
		double hoursWorked;
		double hourlyPay;
		double overtime;
		
		// prompt user for number of employees
		System.out.println("Enter number of employees: ");
		numberOfEmployees = input.nextInt();
		// create an array
		Employee[] employees = new Employee[numberOfEmployees];
		// use a loop for employee data
		for(int i = 0; i < employees.length; i++) {
			// remove the enter key when the user enters the number above
			input.nextLine();
			System.out.println("Enter employee " + (i+1) + "'s name: ");
			name = input.nextLine();
			System.out.println("Enter employee " + (i+1) + "'s weekly hours worked: ");
			hoursWorked = input.nextDouble();
			System.out.println("Enter employee " + (i+1) + "'s hourly pay: ");
			hourlyPay = input.nextDouble();
			// create the employee
			Employee e = new Employee(name, hoursWorked, hourlyPay);
			// add the employee to the array
			employees[i] = e;
		}
		// prompt for overtime if any
		System.out.println("Enter the overtime multiplier for the week: ");
		overtime = input.nextDouble();
		// set overtime for just one employee
		employees[0].setOvertime(overtime);
		// display by using a shorthand for loop
		for(Employee e: employees) {
			System.out.println(e);
		}
		input.close();
		

	}

}
